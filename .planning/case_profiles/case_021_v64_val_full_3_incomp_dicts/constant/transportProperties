// Incompressible Newtonian air @ 15 °C · ρ=1.225 kg/m³ μ=1.79e-5 Pa·s
// ν = μ/ρ = 1.79e-5 / 1.225 = 1.4612e-5 m²/s
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

transportModel  Newtonian;

nu              1.4612e-05;

