// U_inf = 70 m/s · x-direction · NASA TMR canonical inflow
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (70 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (70 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (70 0 0);
    }
    plate
    {
        type            noSlip;
    }
    top
    {
        type            slip;
    }
    frontAndBack
    {
        type            empty;
    }
}

