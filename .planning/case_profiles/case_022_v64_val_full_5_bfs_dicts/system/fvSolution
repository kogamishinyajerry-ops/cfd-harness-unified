// p: GAMG + GaussSeidel · U/k/omega: PBiCGStab + DILU
// URF: p=0.30 U=0.70 k=0.50 ω=0.50 (NASA TMR canonical set)
// residualControl 1e-5 for FULL gate (all 6 fields: p Ux Uy k ω + continuity)
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 100;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    "(U|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;

    residualControl
    {
        p               1e-5;
        U               1e-5;
        k               1e-5;
        omega           1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               0.30;
    }
    equations
    {
        U               0.70;
        k               0.50;
        omega           0.50;
    }
}

