FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         500;
deltaT          1;

writeControl    timeStep;
writeInterval   100;
purgeWrite      2;

writeFormat      ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    forces_rotor
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   10;
        log             yes;

        patches         (rotor_blade_A rotor_blade_B hub_spinner_1 hub_spinner_2);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (0 0 0);
    }

    forceCoeffs_rotor
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   10;
        log             yes;

        patches         (rotor_blade_A rotor_blade_B hub_spinner_1 hub_spinner_2);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (0 0 0);
        liftDir         (0 0 1);
        dragDir         (1 0 0);
        pitchAxis       (0 1 0);
        magUInf         7.0;
        lRef            5.029;
        Aref            79.43;
    }

    forces_thrust_blades
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   10;
        log             yes;

        patches         (rotor_blade_A rotor_blade_B);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (0 0 0);
    }

    residuals
    {
        type            solverInfo;
        libs            ("libutilityFunctionObjects.so");
        fields          (U p k omega);
        writeResidualFields no;
    }
}

