// Laminar regime — Re ≤ 1000, well below cavity transition Re_crit ≈ 7,500
// (Auteri, Quartapelle & Vigevano 2002). NO turbulence model.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}

simulationType  laminar;

