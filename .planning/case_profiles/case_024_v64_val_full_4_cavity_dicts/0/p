// Kinematic pressure (p/ρ) for incompressible solver
// All boundaries are walls → zeroGradient with pRefCell=0 in fvSolution to
// pin the absolute level.
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    lid
    {
        type            zeroGradient;
    }
    walls_fixed
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

