// Kinematic pressure (p/ρ) · gauge zero at outlet
// Analytical dp_kin/dx = -3·ν·u_mean/H² = -0.045 m²/s²/m
// → Δp_kin total over L=0.5 = -0.0225 m²/s² (inlet positive vs outlet zero)
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    bottomWall
    {
        type            zeroGradient;
    }
    topWall
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

