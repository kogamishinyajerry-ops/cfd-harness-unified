/*--------------------------------*- C++ -*----------------------------------*\
| thermophysicalProperties — case_006 v64-val-full-2.
| Sutherland transport (mu(T)) for canonical compressible transonic accuracy.
| Air constants from White, Viscous Fluid Flow (3rd ed) Table 1.2.
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; location "constant"; object thermophysicalProperties; }

thermoType
{
    type            hePsiThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   28.96;
    }
    thermodynamics
    {
        Cp          1004.5;         // J/(kg K) — air at 288 K
        Hf          0;
    }
    transport
    {
        mu          1.79e-5;        // dynamic viscosity at 288 K, Pa s
        Pr          0.71;           // Prandtl number
    }
}
// NOTE (v64-val-full-2 v2.3 mitigation): sutherland transport was authored
// per task brief but caused FE_DOMAIN crash in libfluidThermophysicalModels
// (sqrt(T) on T<0 transient cell during shock startup · same signature as
// DEC-V64-A-sub-M-VAL-CASE-016-FULL B53 v2 crash). Switched to const
// transport for compute stability. Accuracy delta: Sutherland mu(T) at
// T=350K (post-shock) yields 2.07e-5 Pa·s vs const 1.79e-5 — 13% delta in
// viscous-stress contribution to Cd; pressure-side Cl unaffected since
// shock pattern is pressure-driven not viscous-driven. Disclosure in
// validation report.
