/*--------------------------------*- C++ -*----------------------------------*\
| fvSolution — rhoCentralFoam (case_006).                                       |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }

solvers
{
    "(rho|rhoU|rhoE)"
    {
        solver          diagonal;
    }

    // rhoCentralFoam canonical: smoothSolver + symGaussSeidel for U, e, k, omega
    // (DILU unavailable in openfoam-default:2312 for symmetric matrices —
    //  use smoother family per OpenFOAM tutorial set).
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.0;
    }

    e
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.0;
    }

    "(k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.0;
    }
}

PIMPLE
{
    nOuterCorrectors 1;
    nCorrectors      0;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    fields { "(rho|p)" 1.0; }
    equations
    {
        U     1.0;
        e     1.0;
        k     1.0;
        omega 1.0;
    }
}
