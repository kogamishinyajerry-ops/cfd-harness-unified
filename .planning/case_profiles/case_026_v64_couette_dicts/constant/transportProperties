// Incompressible Newtonian (air-like) · ν = 1.5e-5 m²/s · matches B68 Poiseuille
// → Re_h = U_top·H/ν = 0.1·0.01/1.5e-5 = 66.67 (deep laminar · no model)
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

transportModel  Newtonian;

nu              1.5e-05;

