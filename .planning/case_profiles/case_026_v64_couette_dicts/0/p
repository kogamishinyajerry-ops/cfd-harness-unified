// Kinematic pressure (p/ρ) · gauge zero at outlet
// Analytical dp_kin/dx = 0 (pure shear-driven Couette · NO pressure gradient)
// → p should remain ≈ 0 throughout entire domain at machine precision
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    bottomWall
    {
        type            zeroGradient;
    }
    topWall
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

