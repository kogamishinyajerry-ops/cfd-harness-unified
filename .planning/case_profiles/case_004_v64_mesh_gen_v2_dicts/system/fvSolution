FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Minimal solver dict — present so utilities load without error. Solver
// algorithm + tolerances will be re-tuned in M-V64A-VAL-FULL-1.

solvers
{
    p      { solver GAMG; tolerance 1e-7; relTol 0.1; smoother GaussSeidel; }
    U      { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.1; }
    "(k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.1; }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent yes;
    residualControl { p 1e-4; U 1e-4; "(k|omega)" 1e-4; }
}

relaxationFactors
{
    fields { p 0.3; }
    equations { U 0.7; "(k|omega)" 0.7; }
}

