FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Feature edge extraction for snappyHexMesh (OF ESI 2312 per-surface schema).

rotor_blade_a.stl
{
    extractionMethod    extractFromSurface;
    extractFromSurfaceCoeffs { includedAngle 150; }
    subsetFeatures      { nonManifoldEdges yes; openEdges yes; }
    writeObj            no;
    writeFeatureEdgeMesh yes;
}
