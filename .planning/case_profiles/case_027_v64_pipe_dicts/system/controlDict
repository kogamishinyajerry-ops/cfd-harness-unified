// case_027 · simpleFoam steady laminar · 5000-iter cap · Hagen-Poiseuille pipe
// function objects: wallShearStress (τ_w), solverInfo (residuals)
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     simpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         5000;

deltaT          1;

writeControl    timeStep;
writeInterval   500;

purgeWrite      2;

writeFormat     ascii;
writePrecision  10;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    // Wall shear stress (kinematic m²/s²) on pipe wall — τ_w strict-gate
    // Analytical: τ_w_kin = 4·ν·u_mean/R = 4·1.5e-5·0.1/0.005 = 1.2e-3 m²/s²
    wallShearStress1
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
        writeFields     true;
        log             true;
        patches         (wall);
    }

    // Residual extraction for convergence verification
    // Laminar 3D wedge fields: p, U (vector → Ux, Uy, Uz split by solverInfo)
    residuals1
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (p U);
        writeResidualFields false;
        writeControl    timeStep;
        writeInterval   1;
    }
}

