# AI-CFD-V2 .gitignore
# Sources of truth: code in src/, manifests in cases/*/case_manifest.yaml,
# decisions in docs/project-memory/DECISION_LOG.md.
# Everything else listed here is generated or environment-specific.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual envs
.venv/
venv/
.venv-dogfood/

# OS noise
.DS_Store

# CFD generated artifacts — regenerated by blockMesh, decomposePar, simpleFoam
# Sources of truth are the dict files under system/ and constant/.
cases/*/constant/polyMesh/*
!cases/*/constant/polyMesh/.gitkeep
cases/*/0.*/
cases/*/[1-9]*/
cases/*/processor*/
cases/*/postProcessing/

# OpenFOAM 11 writes function-object outputs (yPlus, wallShearStress,
# uniform/) into the 0/ time-step at run time even though the user-
# seeded 0/<field> files are tracked. Whitelist user-seeded files and
# blacklist runtime junk: order matters in .gitignore (later wins).
cases/*/0/uniform/
cases/*/0/yPlus
cases/*/0/wallShearStress
cases/*/0/phi

# Trust harness runtime outputs.
# IMPORTANT (DoD #3 + Non-negotiable #5): trust_report.json and the
# accompanying *.json/*.csv files ARE evidence and MUST be tracked.
# Only the giant verbose logs are ignored — they're reproducible from
# the inputs and would bloat the repo. Everything else under artifacts/
# is intentionally committed so that any trust claim can be inspected.
cases/*/artifacts/*.log
!cases/*/artifacts/README.md

# Editor / IDE
.idea/
.vscode/
*.swp

# Local override files
.env
.envrc
