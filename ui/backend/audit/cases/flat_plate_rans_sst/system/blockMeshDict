/*--------------------------------*- C++ -*----------------------------------*\
| AI-CFD-V2 Phase 1 step 2b scaffold | OpenFOAM 11 | flat_plate_rans_sst    |
| 2.5D box, graded toward bottom wall (target y+ ~ 1 at U=30 m/s)            |
| NOTE: NASA TMR has a leading symmetry section before the plate; this       |
|       scaffold collapses both into one no-slip wall. See CASE_NOTES.md.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

vertices
(
    (0  0    0     )   // 0
    (2  0    0     )   // 1
    (2  1    0     )   // 2
    (0  1    0     )   // 3
    (0  0    0.05  )   // 4
    (2  0    0.05  )   // 5
    (2  1    0.05  )   // 6
    (0  1    0.05  )   // 7
);

blocks
(
    // DEC-V61-209: 2D-refined mesh for y+~1 near-LE resolution.
    // Cell count 100x60 -> 180x90 (16,200 cells; checkMesh-verified clean,
    // max aspect ratio 260.9). x uses multiGrading (2 segments): segment A =
    // first 10% of length [0,0.2m] gets 17.7778% of x-cells (=32) with
    // expansion 4.6495 clustering the smallest cell at the LE (~2.6mm growing
    // to ~12.2mm); segment B = remaining 90% [0.2,2.0m] gets 82.2222% of
    // x-cells (=148) UNIFORM at ~12.2mm (segment A last cell == segment B cell,
    // no size jump). y uses a single expansion ratio 1724 (top-cell/wall-cell)
    // -> wall cell ~4.7e-5 m, giving y+ ~ 1.3 avg in the developed plate.
    // z unchanged (1 cell, 2.5D). Decouples LE x-resolution from downstream
    // wall aspect ratio: dx_downstream/dy_wall = 261 < 1000. The earlier
    // simpleGrading (1 15000 1) attempt failed checkMesh (AR ~1994) because a
    // uniform dx=0.02m wall row with dy~1e-5 gave AR ~1800-1994.
    hex (0 1 2 3 4 5 6 7) (180 90 1)
    simpleGrading
    (
        ( (0.1 0.177778 4.6495) (0.9 0.822222 1) )   // x: LE-clustered then uniform
        1724                                          // y: graded to wall (y+ ~ 1.3)
        1                                             // z
    )
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    wall
    {
        type wall;
        faces
        (
            (0 1 5 4)
        );
    }
    top
    {
        type symmetryPlane;
        faces
        (
            (3 7 6 2)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs
(
);

