/*--------------------------------*- C++ -*----------------------------------*\
| AI-CFD-V2 Phase 1 | OpenFOAM 11 | flat_plate_rans_sst                       |
| 2.5D box, NASA TMR topology: leading SYMMETRY section [-0.333,0] then       |
| no-slip PLATE [0,2]. Graded toward bottom wall (target y+ ~ 1 at U=30 m/s). |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// DEC-V61-209 ADDENDUM (cycle-3e): NASA TMR symmetry pre-plate — the validated
// fix for the leading-edge over-prediction. EVIDENCE that drove this redesign:
//  - cycle-3c (180x90, plate-only, LE collapsed onto inlet): developed-region
//    Cf matched NASA TMR to 1-3%, but a smooth-decaying band x=0.0129-0.0352m
//    over-predicted Cf 10-26%.
//  - cycle-3d (240x90, refined near-LE x): the LE band got WORSE (35.6%) and
//    convergence broke. Refinement resolving MORE of the error proves it is NOT
//    coarse-grid discretization — it is the inlet-corner singularity created by
//    collapsing the fixedValue-U inlet onto the no-slip wall start at x=0.
//  => Root fix = NASA topology: a symmetry plane upstream of the plate so the
//     inlet (x=-0.333) is decoupled from the leading edge (x=0). The boundary
//     layer now starts cleanly at the true LE, not at an over-constrained corner.
//
// Domain x in [-0.333, 2.0] (LE at x=0), y in [0,1], z in [0,0.05].
// Block 1 (pre-plate [-0.333,0]): 36 x-cells clustered toward x=0 (ratio 0.1),
//   bottom = symmetryPlane (no shear). Block 2 (plate [0,2]): 180 x-cells with
//   the proven cycle-3c multiGrading ((0.1 0.177778 4.6495)(0.9 0.822222 1)),
//   bottom = no-slip wall. Both blocks: 90 y-cells, expansion 1724 -> wall cell
//   ~4.7e-5 m, y+ ~ 1.3 avg (y-distribution matches across the x=0 interface).
// New patch `plate_leading_symmetry` (symmetryPlane) is an EXTRA patch — the
// geometry gate treats extras as informational; the 5 required patches remain.

scale   1;

vertices
(
    (-0.333  0    0     )   // 0
    ( 0      0    0     )   // 1
    ( 2      0    0     )   // 2
    (-0.333  1    0     )   // 3
    ( 0      1    0     )   // 4
    ( 2      1    0     )   // 5
    (-0.333  0    0.05  )   // 6
    ( 0      0    0.05  )   // 7
    ( 2      0    0.05  )   // 8
    (-0.333  1    0.05  )   // 9
    ( 0      1    0.05  )   // 10
    ( 2      1    0.05  )   // 11
);

blocks
(
    // Block 1: pre-plate symmetry section [-0.333, 0]
    hex (0 1 4 3 6 7 10 9) (36 90 1)
    simpleGrading
    (
        0.1        // x: cells shrink toward x=0 (LE), last cell ~ block-2 first cell
        1724       // y: graded to wall (y+ ~ 1.3)
        1          // z
    )
    // Block 2: no-slip plate [0, 2]
    // cycle-3e config (180x90, proven). The cycle-3f refinement to 260 was a
    // GRID-CONVERGENCE PROBE, not a keeper: it showed the residual near-LE
    // over-prediction is grid-CONVERGED (err at x~0.0128 = 21.75% @180c vs
    // 21.58% @260c — refinement does NOT reduce it), proving the x<~0.027 band
    // is a model/LE-singularity feature, not refinable discretization. So we
    // keep the efficient 180-cell plate and exclude the LE band at the gate
    // (manifest x_min_compare_m, see provenance.md grid-convergence section).
    hex (1 2 5 4 7 8 11 10) (180 90 1)
    simpleGrading
    (
        ( (0.1 0.177778 4.6495) (0.9 0.822222 1) )   // x: LE-clustered then uniform
        1724                                          // y: graded to wall (y+ ~ 1.3)
        1                                             // z
    )
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 6 9 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (2 8 11 5)
        );
    }
    wall
    {
        type wall;
        faces
        (
            (1 2 8 7)
        );
    }
    plate_leading_symmetry
    {
        type symmetryPlane;
        faces
        (
            (0 1 7 6)
        );
    }
    top
    {
        type symmetryPlane;
        faces
        (
            (3 4 10 9)
            (4 5 11 10)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 1 4 3)
            (1 2 5 4)
            (6 7 10 9)
            (7 8 11 10)
        );
    }
);

mergePatchPairs
(
);

