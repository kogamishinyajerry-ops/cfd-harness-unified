/*--------------------------------*- C++ -*----------------------------------*\
| AI-CFD-V2 Phase 1 | OpenFOAM 11 | flat_plate_rans_sst                       |
| NASA TMR SST freestream (cycle-3g): omega = 125 * U / L = 125*30/1 = 3750   |
|   gives mu_t/mu = k/(omega*nu) = 2.025e-4/(3750*6e-6) = 0.009 (NASA).       |
|   replaces prior omega=67 (mixingLength 0.01, mu_t/mu~336). See DEC-209.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 3750;

boundaryField
{
    inlet
    {
        // NASA TMR SST freestream omega (matches manifest fixedValue 3750)
        type            fixedValue;
        value           uniform 3750;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall
    {
        // matches manifest.bc_contract.wall.omega.type = omegaWallFunction
        type            omegaWallFunction;
        value           uniform 3750;
    }
    top
    {
        type            symmetryPlane;
    }
    plate_leading_symmetry
    {
        type            symmetryPlane;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
