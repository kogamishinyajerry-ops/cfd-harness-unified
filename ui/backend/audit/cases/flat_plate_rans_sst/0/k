/*--------------------------------*- C++ -*----------------------------------*\
| AI-CFD-V2 Phase 1 | OpenFOAM 11 | flat_plate_rans_sst                       |
| NASA TMR SST freestream (cycle-3g): k = 1.125 * U^2 / Re_L                  |
|   = 1.125 * 30^2 / 5e6 = 2.025e-4  (Tu = 0.039%, mu_t/mu = 0.009)           |
|   replaces prior Tu=1% (k=0.135, ~600x too turbulent — caused near-LE       |
|   Cf over-prediction; see manifest bc_contract + DEC-V61-209).             |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.025e-4;

boundaryField
{
    inlet
    {
        // NASA TMR SST freestream k (matches manifest fixedValue 2.025e-4)
        type            fixedValue;
        value           uniform 2.025e-4;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall
    {
        // matches manifest.bc_contract.wall.k.type = kqRWallFunction
        type            kqRWallFunction;
        value           uniform 1e-12;
    }
    top
    {
        type            symmetryPlane;
    }
    plate_leading_symmetry
    {
        type            symmetryPlane;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
