FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Kinematic viscosity of air at ~15 C, 1 atm.
// Re_L = U*L/nu = 30 * 1 / 1.5e-5 = 2e6 → fully-turbulent boundary layer on plate.
nu              1.5e-05;

// ************************************************************************* //
